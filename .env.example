# ==============================================================================
# MiniLedger Environment Configuration Example
# ==============================================================================

# Backend Server Port & Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For local Mac with native Postgres / Homebrew:
# DATABASE_URL="postgresql://aaradhychinche@localhost:5432/miniledger?schema=public"
# For Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# Database Connection for Jest integration tests
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/miniledger_test?schema=public"

# Authentication
JWT_SECRET="miniledger-super-secure-dev-jwt-secret-key-change-in-prod"
JWT_EXPIRES_IN="7d"

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Base URL for static file uploads
APP_BASE_URL="http://localhost:4000"

# Timezone (for overdue date calculations)
TZ="Asia/Kolkata"

# Mobile App (apps/mobile/.env)
# EXPO_PUBLIC_API_URL="http://localhost:4000/api"
# For physical phone on same Wi-Fi, replace localhost with your LAN IP (e.g. http://192.168.1.5:4000/api)
# For Android Emulator, use http://10.0.2.2:4000/api
